<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 唤醒亮屏：灵动模式空闲息屏后，喊唤醒词用唤醒锁把屏幕点亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      空闲息屏需要把系统屏幕超时对齐到设定值（WRITE_SETTINGS，可在应用内授权），
      并关掉「充电时保持唤醒」（WRITE_SECURE_SETTINGS，普通应用拿不到，
      由部署方用 adb 授权或在 root/系统签名环境预置）。拿不到也不影响应用侧保持亮屏。
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 卡片分享保存到相册：Android 9 及以下写公共 Pictures 需要存储权限（10+ 走 MediaStore 免授权） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 扫码同步配置：只有扫码用，无相机的设备（车机）不影响安装与使用 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ 包可见性：语音识别服务（SpeechRecognizer 绑定需要） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 包可见性：判断高德地图是否安装（会话地图卡「高德地图」按钮跳转需要） -->
        <package android:name="com.autonavi.minimap" />
        <!-- 包可见性：卡片分享判断微信是否安装（未装则退回系统分享面板） -->
        <package android:name="com.tencent.mm" />
        <!-- 包可见性：卓易通环境检测（鸿蒙 NEXT 的安卓容器里微信拉不起，直接走系统分享面板） -->
        <package android:name="com.zhuoyi.appstore.lite" />
    </queries>

    <!-- usesCleartextTraffic：扫码同步配置走局域网明文 HTTP（http://192.168.x.x），
         新版安卓默认禁止，需显式放开；外部接口（DeepSeek/高德等）仍全部为 HTTPS -->
    <application
        android:name=".TravelApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lvyoubao">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 注册为桌面（HOME）：用户可在系统里设为默认桌面，开机即进本应用 -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 后台常驻前台服务（设置 → 桌面与后台 → 「后台常驻运行」） -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep_alive" />
        </service>

        <!-- 开机自启（设置 → 桌面与后台 → 「开机自启」） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".sensing.FatigueSensingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
